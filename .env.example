APP_ENV=development
SECRET_KEY=change-me
API_PORT=5000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000

# Postgres container credentials (also used to build DATABASE_URL below)
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app

# Used when running Flask on your host (make dev). Inside Docker, compose overrides
# these with the service hostnames (db / redis).
DATABASE_URL=postgresql+psycopg2://app:app_password@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
