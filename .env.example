APP_ENV=development
SECRET_KEY=change-me
API_PORT=5000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000

# Postgres container credentials (also used to build DATABASE_URL below)
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app

# Used when running Flask on your host (make dev). Inside Docker, compose overrides
# these with the service hostnames (db / redis).
DATABASE_URL=postgresql+psycopg2://app:app_password@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

# ---- RAG ----
# Required to answer questions (get one at console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# fastembed = local model, no key needed. Others need their package + key (see requirements.txt).
EMBEDDINGS_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# MUST match the model's output size (bge-small = 384). Changing it later means a fresh DB (make reset).
EMBEDDING_DIM=384
MAX_UPLOAD_MB=10
MAX_DOCS_PER_USER=10
ASK_RATE_LIMIT=20
